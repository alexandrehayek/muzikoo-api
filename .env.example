# Copy to .env and fill in. .env is gitignored.

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=muzikoo_api
DB_USER=muzikoo
DB_PASSWORD=

# Optional: set this to override the URL assembled from the parts above.
# DATABASE_URL=postgresql+psycopg2://muzikoo:pass@localhost:5432/muzikoo_api

# --- Ingest ----------------------------------------------------------------
DATASET_PATH=data/dataset.json
CHUNK_SIZE=5000

# --- Model -----------------------------------------------------------------
MODEL_PATH=models/knn_model.joblib

# --- API -------------------------------------------------------------------
DEFAULT_LIMIT=50
MAX_LIMIT=200
# Comma-separated origins for CORS. Empty = CORS disabled.
CORS_ORIGINS=

# Comma-separated list of accepted ?api_key= values. Required: with none set,
# /v1 answers 503. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=
