# Copy to .env and fill in. .env is gitignored.

# --- Database: development -------------------------------------------------
# Local PostgreSQL. Used whenever DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=muzikoo_api
DB_USER=muzikoo
DB_PASSWORD=

# --- Database: production --------------------------------------------------
# One connection string, and it overrides every DB_* value above. On Vercel
# this is set in the project's environment variables, not in a file.
#
# Use Supabase's TRANSACTION pooler (port 6543) for the deployed API: each
# serverless invocation is short-lived, so it must not hold a session.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Migrations (pg_restore, schema changes) need the SESSION pooler, port 5432:
#   SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Leave DATABASE_URL empty for local development.
DATABASE_URL=

# --- Ingest ----------------------------------------------------------------
DATASET_PATH=data/dataset.json
CHUNK_SIZE=5000

# --- Model -----------------------------------------------------------------
MODEL_PATH=models/knn_model.joblib

# --- API -------------------------------------------------------------------
DEFAULT_LIMIT=50
MAX_LIMIT=200
# Comma-separated browser origins allowed to call the API.
# Empty = allow any origin ("*").
CORS_ORIGINS=

# Comma-separated list of accepted ?api_key= values. Required: with none set,
# /v1 answers 503. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=
