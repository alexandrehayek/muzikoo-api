# Secrets / local config
.env

# Data (dataset.json is 1.3 GB — keep it out of git)
data/*.json
!data/dataset-sample.json

# Database dumps produced by `make db-dump`
dumps/

# NOTE: models/knn_model.joblib is intentionally NOT ignored. Vercel builds
# from the git repository, so the trained artifact has to be committed for
# track.getsimilar to work in production (~23 MB; use Git LFS if the retrain
# cadence makes that history painful).

# Vercel CLI
.vercel/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
